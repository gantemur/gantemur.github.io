<script>
  (function () {
    var root = document.documentElement;
    var base = "gantemur.github.io/cal/";
    function setLinks() {
      var app = root.dataset.app, phone = root.dataset.phone === "1", android = root.dataset.android === "1";
      document.querySelectorAll(".cal-pill[data-feed]").forEach(function (a) {
        var f = a.dataset.feed;
        a.removeAttribute("target");
        if (app === "apple") {
          a.href = "webcal://" + base + f;
          a.dataset.copy = "";
        } else if (app === "google" && android) {
          // Hand the http:// address to the Google Calendar app via Chrome
          // (the https:// form fails silently in the app; tester report 2026-11-16).
          var cid = encodeURIComponent("http://" + base + f);
          a.href = "intent://calendar.google.com/calendar/render?cid=" + cid +
            "#Intent;scheme=https;package=com.android.chrome;S.browser_fallback_url=" +
            encodeURIComponent("https://calendar.google.com/calendar/render?cid=" + cid) + ";end";
          a.dataset.copy = "";
        } else if (app === "google" && !phone) {
          a.href = "https://calendar.google.com/calendar/render?cid=webcal://" + base + f;
          a.target = "_blank";
          a.rel = "noopener";
          a.dataset.copy = "";
        } else {
          a.href = "https://" + base + f;
          a.dataset.copy = "1";
        }
      });
    }
    function copy(a) {
      var url = "https://" + base + a.dataset.feed;
      var done = function () {
        a.classList.add("copied");
        setTimeout(function () { a.classList.remove("copied"); }, 2000);
      };
      var fallback = function () {
        var box = a.closest(".cal-row").querySelector(".feed-url");
        if (!box) {
          box = document.createElement("input");
          box.className = "feed-url";
          box.readOnly = true;
          a.closest(".cal-row").appendChild(box);
        }
        box.value = url;
        box.focus();
        box.select();
      };
      try { navigator.clipboard.writeText(url).then(done, fallback); } catch (e) { fallback(); }
    }
    document.querySelectorAll(".cal-pill[data-feed]").forEach(function (a) {
      a.addEventListener("click", function (e) {
        if (a.dataset.copy === "1") { e.preventDefault(); copy(a); }
      });
    });
    function choose(v) {
      root.dataset.app = v;
      try { localStorage.setItem("cal-app", v); } catch (e) {}
      setLinks();
    }
    document.querySelectorAll(".app-switch button").forEach(function (b) {
      b.addEventListener("click", function () { choose(b.dataset.app); });
    });
    document.querySelectorAll("[data-goto]").forEach(function (a) {
      a.addEventListener("click", function (e) {
        e.preventDefault();
        choose(a.dataset.goto);
        document.querySelector(".app-box").scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });
    if (root.dataset.android === "1") {
      var u = "https://calendar.google.com/calendar/r/settings/addbyurl";
      document.getElementById("addbyurl").href = "intent://calendar.google.com/calendar/r/settings/addbyurl" +
        "#Intent;scheme=https;package=com.android.chrome;S.browser_fallback_url=" + encodeURIComponent(u) + ";end";
    }
    document.querySelectorAll(".lang-switch a").forEach(function (a) {
      a.addEventListener("click", function (e) {
        e.preventDefault();
        var en = a.dataset.set === "en";
        root.classList.toggle("ui-en", en);
        root.lang = en ? "en" : "mn";
        try { localStorage.setItem("cal-lang", a.dataset.set); } catch (err) {}
        try { history.replaceState(null, "", en ? "?lang=en" : location.pathname); } catch (err) {}
      });
    });
    setLinks();
  })();
</script>

